{
  "name": "voto-consciente-2026",
  "version": "1.0.0",
  "description": "VotoConsciente 2026 - Analisador Político & Santinho Digital (SP)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm run dev -w @voto-consciente/backend\" \"npm run dev -w @voto-consciente/frontend\"",
    "dev:backend": "npm run dev -w @voto-consciente/backend",
    "dev:frontend": "npm run dev -w @voto-consciente/frontend",
    "build": "npm run build --workspaces",
    "start:backend": "npm run start -w @voto-consciente/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "eleicoes-2026",
    "politica",
    "sao-paulo",
    "santinho-digital",
    "clean-architecture",
    "vue3",
    "fastify"
  ],
  "author": "Antigravity Architect",
  "license": "MIT"
}
